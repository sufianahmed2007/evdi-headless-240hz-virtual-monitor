[Unit]
Description=Keep EVDI display to the right of HDMI on Plasma Login Manager
After=plasmalogin.service
PartOf=plasmalogin.service

[Service]
ExecStart=/usr/local/bin/evdi-plasmalogin-watch
Restart=always
RestartSec=2
Environment=EVDI_LAYOUT_STATE=/var/lib/evdi-headless/layout-state.json

[Install]
WantedBy=graphical.target
